# College website chatbot — every environment variable the app reads.
# Copy to .env.local (gitignored) and fill in the dedicated test-project
# values. Localhost and Vercel test use the same hosted Supabase test project.

# --- Store selection (src/config.ts) ---
# Postgres connection string (Supabase in production, a local cluster for
# development and tests). Takes precedence over CHATBOT_DB.
DATABASE_URL=
# Fallback alias for DATABASE_URL, accepted for convenience.
POSTGRES_URL=
# SQLite database file used by isolated application tests.
CHATBOT_DB=chatbot.db
# Production (or =1 on any run) refuses to start without a Postgres URL —
# there is no SQLite fallback on the server's read-only filesystem (ticket 22).
CHATBOT_REQUIRE_DATABASE_URL=

# --- Supabase Auth (src/auth/supabase-provider.ts) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Public origin (src/config.ts) ---
# The origin the app is served from; drives trusted origins and the CSP
# frame-ancestors list for the widget embed.
CHATBOT_BASE_URL=http://localhost:3000
# --- Postgres tuning (src/db/postgres.ts) ---
# Supabase's shared poolers reject prepared statements, so they stay off
# unless set to "true" (for a direct, non-pooled connection).
PG_PREPARE=
# Main query pool size per instance (default 4 — matches the Settings
# page's four-read concurrency; keep it low on Vercel, where every warm
# instance contributes this many client connections to the pooler).
PG_POOL_MAX=4

# --- Scheduled maintenance (src/app/api/maintenance/route.ts) ---
# Bearer token the scheduled Vercel cron sends; any long random string.
CRON_SECRET=

# --- Rate limiting (src/api/rateLimit.ts) ---
# Shared public rate-limit window in milliseconds (default 60000).
RATE_WINDOW_MS=60000

# --- Tests (tests/helpers.ts) ---
# When set, the whole suite runs against Postgres: one freshly-migrated
# database per file is created on this server (ticket 11 parity runs).
CHATBOT_TEST_POSTGRES_URL=

# --- Trusted owner bootstrap and recovery ---
# npm run bootstrap:owner -- --email you@example.edu --name "College Owner"
# npm run recover:staff -- --email you@example.edu --identity-verified

# --- Configuration-only transfer ---
# Export uses one read-only source plus a new output path.
CONFIG_SOURCE_DATABASE_URL=
CONFIG_SOURCE_SQLITE_PATH=
CONFIG_TARGET_DATABASE_URL=
CONFIG_BUNDLE_PATH=
