{
  "name": "sfc-chatbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "College website chatbot and live staff takeover (see .scratch/college-website-chat/spec.md)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run hygiene && npm run typecheck && npm test && npm run build",
    "dev": "npm run build:widget && next dev",
    "start": "npm run build:widget && next start",
    "build": "npm run build:widget && next build",
    "typecheck": "tsc --noEmit",
    "build:widget": "tsx scripts/build-widget.ts",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "recover:staff": "tsx scripts/recover-staff-credentials.ts",
    "config:export": "tsx scripts/export-configuration.ts",
    "config:import": "tsx scripts/import-configuration.ts",
    "hygiene": "node scripts/check-repository-hygiene.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "otpauth": "^9.5.2",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.4.2",
    "postgres": "4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
