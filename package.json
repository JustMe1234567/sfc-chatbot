{
  "name": "sfc-chatbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "College website chatbot and live staff takeover (see .scratch/college-website-chat/spec.md)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:widget && next dev",
    "start": "npm run build:widget && next start",
    "build": "npm run build:widget && next build",
    "typecheck": "tsc --noEmit",
    "build:widget": "tsx scripts/build-widget.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
